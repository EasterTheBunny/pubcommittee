      "heading": "In general",
      "source_id": "H1280109BC2214DBAB959EAA99D73EFAF",
      "lines": [
        {
          "n": 2,
          "anchor": "s2-l2",
          "depth": 0,
          "text": "The Occupational Safety and Health Act of 1970 is repealed. The Occupational Safety and Health Administration is abolished.",
          "source_id": "H1280109BC2214DBAB959EAA99D73EFAF",
          "kind": "text"
        }
